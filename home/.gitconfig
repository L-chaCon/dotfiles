[alias]
    glog = log --oneline --graph --decorate

[gpg]
    format = ssh

[commit]
    gpgsign = true

[init]
    defaultBranch = main

[core]
    pager = delta
    excludesFile = "~/.gitignore_global"
    autocrlf = input
    safecrlf = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true
    line-numbers = true

[merge]
    tool = "nvim"

[mergetool]
    keepBackup = false
    prompt = false

[mergetool "nvim"]
    cmd = "nvim -d -c \"wincmd l\" -c \"norm ]c\" \"$LOCAL\" \"$MERGED\" \"$REMOTE\""

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true

[branch]
    sort = -committerdate

[tag]
    sort = -version:refname

[rerere]
    enabled = true
    autoupdate = true

[url "ssh://git@github.com/"]
    insteadOf = https://github.com/

# Platform-specific signing program (op-ssh-sign path differs per OS).
# Stowed from home-mac/ or home-linux/ — silently ignored if missing.
[include]
    path = ~/.gitconfig.platform

# Active identity: pow git chacon  OR  pow git work
[include]
    path = ~/.gitconfig.active
