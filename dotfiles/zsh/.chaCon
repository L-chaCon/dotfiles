# vim: ft=zsh

# -- Plugins
source ~/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source ~/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# -- Make sure .config is the config home
export XDG_CONFIG_HOME=$HOME/.config

# -- History options. more similar to oh-my-zsh
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

setopt EXTENDED_HISTORY       # record timestamp + duration of each command
setopt INC_APPEND_HISTORY     # write to history file immediately, not just on shell exit
setopt SHARE_HISTORY          # share history across all open sessions
setopt HIST_EXPIRE_DUPS_FIRST # if trimming, drop dupes first
setopt HIST_IGNORE_DUPS       # don't record a line if it's a dupe of the previous one
setopt HIST_IGNORE_ALL_DUPS   # remove older dupe when a new dupe is added
setopt HIST_FIND_NO_DUPS      # don't show dupes when searching history
setopt HIST_IGNORE_SPACE      # don't record lines starting with a space
setopt HIST_SAVE_NO_DUPS      # don't write dupes to the history file
setopt HIST_VERIFY            # show expanded command before running from !history

# -- herdr sessionizer  (Ctrl-Space)
# Fires at the shell prompt. Inside Herdr, Herdr's own Ctrl-Space keybinding
# intercepts it first; this covers plain terminals outside Herdr.
herdr_sessionizer_widget() {
  ~/.local/scripts/herdr-sessionizer
  zle reset-prompt
}
zle -N herdr_sessionizer_widget
bindkey '^@' herdr_sessionizer_widget

# -- Options
set -o vi
export LANG=en_GB.UTF-8
export EDITOR="nvim"
BAT="bat"

# -- Ghostty
if [[ -n $GHOSTTY_RESOURCES_DIR ]]; then
  source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
fi

# -- Aliases
alias rm="rm -iv"
alias bathelp="$BAT --plain --language=help"
help() {
    "$@" --help 2>&1 | bathelp
}
alias -g -- --help="--help 2>&1 | bathelp"

# -- Paths
export PATH="$PATH:$HOME/.local/nvim/bin"
export PATH="$PATH:$HOME/.local/scripts"

# -- Man
export MANPATH="/usr/local/man:$MANPATH"
export MANPAGER="sh -c 'col -bx | $BAT -l man -p'"
export MANROFFOPT="-c"

# -- Tools
eval "$(starship init zsh)"
