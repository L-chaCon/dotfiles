#!/usr/bin/env bash
# pow — dotfiles management CLI
# Usage: pow <command> [args]

set -euo pipefail

readonly RED=$'\033[0;31m'
readonly GREEN=$'\033[0;32m'
readonly YELLOW=$'\033[0;33m'
readonly BLUE=$'\033[0;34m'
readonly CYAN=$'\033[0;36m'
readonly BOLD=$'\033[1m'
readonly RESET=$'\033[0m'

__resolve_script_dir() {
  local src="${BASH_SOURCE[0]}"
  while [[ -L "$src" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

readonly DOTFILES_DIR="$(__resolve_script_dir)"
readonly PACKAGES_DIR="$DOTFILES_DIR/packages"
readonly GIT_PROFILES=(chacon work)
readonly ZSH_CORE_PATH='$HOME/.config/zsh/core.zsh'
readonly ZSH_LOCAL_PATH='$HOME/.zshrc.local'

__is_mac() { [[ "$(uname)" == "Darwin" ]]; }
__is_linux() { [[ "$(uname)" == "Linux" ]]; }
__cmd() { command -v "$1" >/dev/null 2>&1; }
__shell_is_zsh() { [[ "${SHELL##*/}" == "zsh" ]]; }

__header() { echo -e "\n${BOLD}${BLUE}==>${RESET} ${BOLD}$1${RESET}"; }
__ok() { echo -e "${GREEN}✓${RESET} $1"; }
__err() { echo -e "${RED}✗${RESET} $1" >&2; }
__warn() { echo -e "${YELLOW}⚠${RESET} $1"; }
__info() { echo -e "${CYAN}ℹ${RESET} $1"; }

__confirm() {
  local prompt="$1" default="${2:-n}" resp
  [[ "$default" == "y" ]] && prompt="$prompt [Y/n]: " || prompt="$prompt [y/N]: "
  read -r -p "$prompt" resp
  case "$resp" in
    [yY]*) return 0 ;;
    [nN]*) return 1 ;;
    "") [[ "$default" == "y" ]] ;;
    *) return 1 ;;
  esac
}

__is_managed_link() {
  local path="$1"
  while [[ "$path" != "$HOME" && "$path" != "/" ]]; do
    [[ -L "$path" ]] && return 0
    path="$(dirname "$path")"
  done
  [[ -L "$path" ]]
}

__zshrc_has_loader() {
  local zshrc="$HOME/.zshrc"
  [[ -f "$zshrc" ]] && grep -qF "$ZSH_CORE_PATH" "$zshrc"
}

__ensure_zshrc() {
  local zshrc="$HOME/.zshrc"

  if [[ -L "$zshrc" ]]; then
    rm "$zshrc"
  fi

  if __zshrc_has_loader; then
    __ok "~/.zshrc loader already present"
    return 0
  fi

  if [[ -f "$zshrc" ]]; then
    __warn "~/.zshrc exists and is not managed by pow"
    __info "Add this line near the top: source \"$ZSH_CORE_PATH\""
    return 0
  fi

  cat > "$zshrc" <<EOF
# Generated by pow.
# Keep machine-specific additions in ~/.zshrc.local or below this block.
[[ -f "$ZSH_CORE_PATH" ]] && source "$ZSH_CORE_PATH"
[[ -f "$ZSH_LOCAL_PATH" ]] && source "$ZSH_LOCAL_PATH"
EOF
  __ok "Created ~/.zshrc loader"
}

__backup_stow_conflicts() {
  local pkg="$1" ts output line rel target
  ts="$(date +%s)"
  output="$(stow -n -R --no-folding -d "$DOTFILES_DIR" -t "$HOME" "$pkg" 2>&1 || true)"

  while IFS= read -r line; do
    if [[ "$line" =~ existing\ target\ (.+)\ since ]]; then
      rel="${BASH_REMATCH[1]}"
      target="$HOME/$rel"
      if [[ -e "$target" && ! -L "$target" ]]; then
        mv "$target" "${target}.bak.${ts}"
        __info "Backed up $rel → ${rel}.bak.${ts}"
      fi
    fi
  done <<<"$output"
}

__restow_pkg() {
  local pkg="$1"
  stow -D --no-folding -d "$DOTFILES_DIR" -t "$HOME" "$pkg" >/dev/null 2>&1 || true
  __backup_stow_conflicts "$pkg"
  stow -R --no-folding -d "$DOTFILES_DIR" -t "$HOME" "$pkg" || {
    __err "stow $pkg/ failed"
    return 1
  }
}

__install_homebrew() {
  if __cmd brew; then
    __ok "Homebrew already installed"
    return 0
  fi

  __info "Installing Homebrew..."
  if NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
    if [[ "$(uname -m)" == "arm64" ]]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    else
      eval "$(/usr/local/bin/brew shellenv)"
    fi
    __ok "Homebrew installed"
    return 0
  fi

  __err "Homebrew installation failed"
  return 1
}

__install_packages() {
  if [[ ! -f "$PACKAGES_DIR/Brewfile" ]]; then
    __err "Brewfile not found at $PACKAGES_DIR/Brewfile"
    return 1
  fi

  __info "Installing Brewfile packages..."
  brew bundle --file="$PACKAGES_DIR/Brewfile" || __warn "Some packages failed"
  __ok "Base packages installed"

  if [[ -f "$PACKAGES_DIR/Brewfile.work" ]] && __confirm "Install work packages?" "n"; then
    brew bundle --file="$PACKAGES_DIR/Brewfile.work" --no-lock ||
      __warn "Some work packages failed"
  fi
}

__install_pacman() {
  if [[ ! -f "$PACKAGES_DIR/pacman" ]]; then
    __err "Package list not found at $PACKAGES_DIR/pacman"
    return 1
  fi

  local pkgs=()
  while IFS= read -r line; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    pkgs+=("$line")
  done < "$PACKAGES_DIR/pacman"

  local to_install=()
  for pkg in "${pkgs[@]}"; do
    pacman -Q "$pkg" >/dev/null 2>&1 || to_install+=("$pkg")
  done

  if [[ ${#to_install[@]} -eq 0 ]]; then
    __ok "All packages already installed"
    return 0
  fi

  __info "Installing: ${to_install[*]}"
  if sudo pacman -S --noconfirm "${to_install[@]}"; then
    __ok "Packages installed"
    return 0
  fi

  __err "pacman install failed"
  return 1
}

__stow_dotfiles() {
  if ! __cmd stow; then
    __err "stow not found"
    return 1
  fi

  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"

  __restow_pkg home || return 1

  if __is_mac; then
    __restow_pkg home-mac || return 1
  fi

  if __is_linux; then
    __restow_pkg home-linux || return 1
  fi

  __ensure_zshrc || return 1

  [[ -f "$HOME/.ssh/config" ]] && chmod 600 "$HOME/.ssh/config"
  __ok "Dotfiles stowed"
}

__install_zsh_plugins() {
  local dir="$HOME/.zsh/plugins"
  mkdir -p "$dir"

  if [[ ! -d "$dir/zsh-autosuggestions" ]]; then
    __info "Cloning zsh-autosuggestions..."
    git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions "$dir/zsh-autosuggestions" &&
      __ok "zsh-autosuggestions installed" || __warn "Clone failed"
  else
    __ok "zsh-autosuggestions already present"
  fi

  if [[ ! -d "$dir/zsh-syntax-highlighting" ]]; then
    __info "Cloning zsh-syntax-highlighting..."
    git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting "$dir/zsh-syntax-highlighting" &&
      __ok "zsh-syntax-highlighting installed" || __warn "Clone failed"
  else
    __ok "zsh-syntax-highlighting already present"
  fi
}

__install_pi_packages() {
  if ! __cmd pi; then
    __warn "pi not found in PATH — skipping pi extensions"
    return 1
  fi

  if [[ ! -f "$PACKAGES_DIR/pi" ]]; then
    __warn "No pi package list at $PACKAGES_DIR/pi"
    return 0
  fi

  local installed source
  installed="$(pi list 2>/dev/null || true)"

  while IFS= read -r source; do
    [[ -z "$source" || "$source" == \#* ]] && continue
    if grep -qF "$source" <<<"$installed"; then
      __ok "$source already installed"
      continue
    fi
    __info "Installing $source..."
    if pi install "$source"; then
      __ok "$source installed"
    else
      __warn "Failed to install $source"
    fi
  done < "$PACKAGES_DIR/pi"
}

__set_zsh_default() {
  if __shell_is_zsh; then
    __ok "zsh is already the default shell"
    return 0
  fi

  local zsh_path
  zsh_path="$(command -v zsh 2>/dev/null)" || {
    __warn "zsh not found"
    return 1
  }

  grep -qF "$zsh_path" /etc/shells || echo "$zsh_path" | sudo tee -a /etc/shells >/dev/null

  __info "Changing default shell to zsh..."
  if chsh -s "$zsh_path"; then
    __ok "Default shell changed to zsh"
    __warn "Log out and back in for the change to take effect"
    return 0
  fi

  __err "chsh failed"
  return 1
}

__generate_ssh_key() {
  local key="$HOME/.ssh/chacon"
  if [[ -f "$key" ]]; then
    __ok "SSH key already exists at $key"
    return 0
  fi

  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  __info "Generating SSH key..."
  if ssh-keygen -t ed25519 -C "montt.octavio@gmail.com" -f "$key" -N ""; then
    __ok "SSH key generated — add to GitHub: cat ${key}.pub"
    return 0
  fi

  __err "SSH key generation failed"
  return 1
}

__install_font() {
  if ls "$HOME/Library/Fonts"/JetBrainsMonoNLNerdFont* >/dev/null 2>&1; then
    __ok "JetBrains Nerd Font already installed"
    return 0
  fi

  __info "Installing JetBrains Mono Nerd Font..."
  if brew install --cask font-jetbrains-mono-nerd-font; then
    __ok "Font installed"
    return 0
  fi

  __warn "Font installation failed"
  return 1
}

__check_op_signer() {
  local signer
  if __is_mac; then
    signer="/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  else
    signer="/opt/1Password/op-ssh-sign"
  fi
  [[ -x "$signer" ]] || __warn "op-ssh-sign not found at $signer — commit signing may fail"
}

__git_active_profile() {
  local active="$HOME/.gitconfig.active"
  [[ ! -e "$active" ]] && echo "none" && return 1
  basename "$(readlink "$active" 2>/dev/null || echo "$active")" | sed 's/^\.gitconfig\.//'
}

__set_git_profile() {
  local profile="$1" target="$HOME/.gitconfig.$1"
  [[ -f "$target" ]] || {
    __err "Profile file not found: $target (run pow stow first)"
    return 1
  }

  ln -sf "$target" "$HOME/.gitconfig.active"
  __ok "Git profile → $profile"
  echo "  name:     $(git config --file "$target" user.name 2>/dev/null || true)"
  echo "  email:    $(git config --file "$target" user.email 2>/dev/null || true)"
  echo "  username: $(git config --file "$target" user.username 2>/dev/null || true)"
  __check_op_signer
}

cmd_init() {
  local skip_ssh=false skip_font=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --skip-ssh) skip_ssh=true ;;
      --skip-font) skip_font=true ;;
      -h|--help)
        echo "Usage: pow init [--skip-ssh] [--skip-font]"
        return 0
        ;;
      *)
        __err "Unknown option: $1"
        return 1
        ;;
    esac
    shift
  done

  __header "Initialising dotfiles ($(uname))"

  if __is_mac; then
    __header "Homebrew"
    __install_homebrew || return 1

    __header "Homebrew packages"
    __install_packages || return 1
  fi

  if __is_linux; then
    __header "Pacman packages"
    __install_pacman || return 1
  fi

  __header "Stow dotfiles"
  __stow_dotfiles || return 1

  __header "Zsh plugins"
  __install_zsh_plugins || __warn "zsh plugin installation failed"

  __header "pi extensions"
  __install_pi_packages || __warn "pi extension installation failed"

  __header "Default shell"
  __set_zsh_default || __warn "default shell step failed"

  if [[ "$skip_ssh" != true ]]; then
    __header "SSH key"
    __generate_ssh_key || __warn "SSH key step failed"
  fi

  if __is_mac && [[ "$skip_font" != true ]]; then
    __header "JetBrains font"
    __install_font || __warn "font installation failed"
  fi

  __header "Done 🎉  — run: ./pow link  then restart your terminal"
}

cmd_update() {
  __header "Updating dotfiles"
  git -C "$DOTFILES_DIR" pull || {
    __err "git pull failed"
    return 1
  }
  __ok "Repository updated"

  if __is_mac; then
    brew update && brew upgrade
    __ok "Homebrew packages updated"
  fi

  if __is_linux; then
    sudo pacman -Syu --noconfirm
    __ok "System packages updated"
  fi

  __stow_dotfiles || return 1

  if __cmd pi; then
    __info "Updating pi and extensions..."
    pi update --all 2>/dev/null || pi update 2>/dev/null || __warn "pi update failed"
    __install_pi_packages
  fi

  __ok "Update complete"
}

cmd_doctor() {
  __header "Running diagnostics ($(uname))"
  local issues=0 warnings=0

  doctor_issue() {
    __err "$1"
    ((++issues))
  }

  doctor_warn() {
    __warn "$1"
    ((++warnings))
  }

  for tool in nvim zsh starship fzf bat zoxide lsd delta herdr stow git; do
    if __cmd "$tool"; then
      __ok "$tool"
    else
      doctor_warn "$tool not found"
    fi
  done

  if __cmd pi && [[ -f "$PACKAGES_DIR/pi" ]]; then
    local installed source
    installed="$(pi list 2>/dev/null || true)"
    while IFS= read -r source; do
      [[ -z "$source" || "$source" == \#* ]] && continue
      if grep -qF "$source" <<<"$installed"; then
        __ok "pi: $source"
      else
        doctor_warn "pi extension missing: $source  (run: pow init)"
      fi
    done < "$PACKAGES_DIR/pi"
  fi

  if __is_mac; then
    if __cmd brew; then
      __ok "brew"
    else
      doctor_issue "brew missing"
    fi

    if __cmd aerospace; then
      __ok "aerospace"
    else
      doctor_warn "aerospace not found"
    fi
  fi

  if __shell_is_zsh; then
    __ok "default shell: $SHELL"
  else
    doctor_issue "default shell is $SHELL — run: pow init"
  fi

  [[ -d "$HOME/.zsh/plugins/zsh-autosuggestions" ]] &&
    __ok "zsh-autosuggestions" || doctor_warn "zsh-autosuggestions missing"
  [[ -d "$HOME/.zsh/plugins/zsh-syntax-highlighting" ]] &&
    __ok "zsh-syntax-highlighting" || doctor_warn "zsh-syntax-highlighting missing"

  if [[ -S "$HOME/.1password/agent.sock" ]]; then
    __ok "1Password SSH agent socket present"
  else
    doctor_warn "1Password SSH agent socket missing (~/.1password/agent.sock)"
    __info "Fix: 1Password → Settings → Developer → Use the SSH agent"
  fi

  local profile
  profile="$(__git_active_profile 2>/dev/null || echo none)"
  if [[ "$profile" != "none" ]]; then
    __ok "Git profile: $profile"
  else
    doctor_warn "No git profile set — run: pow git chacon"
  fi

  if __zshrc_has_loader; then
    __ok "~/.zshrc loader present"
  else
    doctor_warn "~/.zshrc is missing the pow loader"
  fi

  for path in \
    "$HOME/.config/zsh/core.zsh" \
    "$HOME/.gitconfig" \
    "$HOME/.config/starship.toml" \
    "$HOME/.config/herdr/config.toml" \
    "$HOME/.config/ghostty/config.ghostty"; do
    if __is_managed_link "$path"; then
      __ok "managed: $(basename "$path")"
    else
      doctor_warn "not symlinked: $path  (run: pow stow)"
    fi
  done

  if __cmd pow; then
    __ok "pow is on PATH"
  else
    doctor_warn "pow not on PATH — run: pow link"
  fi

  if [[ $issues -eq 0 && $warnings -eq 0 ]]; then
    __header "All checks passed ✨"
    return 0
  fi

  __header "Doctor summary"
  echo "issues:   $issues"
  echo "warnings: $warnings"
}

cmd_stow() {
  __header "Stowing dotfiles"
  __stow_dotfiles
}

cmd_link() {
  __header "Linking pow to PATH"
  mkdir -p "$HOME/.local/bin"
  ln -sf "$DOTFILES_DIR/pow" "$HOME/.local/bin/pow"
  __ok "Linked: ~/.local/bin/pow → $DOTFILES_DIR/pow"
  __info "~/.local/bin is on PATH after your first zsh session"
}

cmd_unlink() {
  __header "Unlinking pow"
  local link="$HOME/.local/bin/pow"
  [[ -L "$link" ]] && rm "$link" && __ok "Removed $link" || __warn "No symlink at $link"
}

cmd_edit() {
  __cmd "${EDITOR:-nvim}" || {
    __err "Editor '${EDITOR:-nvim}' not found"
    return 1
  }
  exec "${EDITOR:-nvim}" "$DOTFILES_DIR"
}

cmd_git() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    list)
      local active
      active="$(__git_active_profile 2>/dev/null || echo none)"
      for profile in "${GIT_PROFILES[@]}"; do
        [[ "$profile" == "$active" ]] && echo "  * $profile (active)" || echo "    $profile"
      done
      ;;
    current)
      __git_active_profile || {
        echo "No active profile"
        return 1
      }
      ;;
    chacon|work)
      __set_git_profile "$sub"
      ;;
    *)
      echo "Usage: pow git list|current|chacon|work"
      ;;
  esac
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true
case "$cmd" in
  init) cmd_init "$@" ;;
  update) cmd_update "$@" ;;
  doctor) cmd_doctor "$@" ;;
  stow) cmd_stow "$@" ;;
  link) cmd_link "$@" ;;
  unlink) cmd_unlink "$@" ;;
  edit) cmd_edit "$@" ;;
  git) cmd_git "$@" ;;
  -h|--help|help|"")
    cat <<EOF
${BOLD}pow${RESET} — dotfiles management

${BOLD}USAGE${RESET}  pow <command> [args]

${BOLD}COMMANDS${RESET}
  init    [--skip-ssh] [--skip-font]   Bootstrap new machine
  update                               Pull latest + update packages + restow
  doctor                               Health check
  stow                                 (Re)stow dotfiles
  link                                 Install pow to ~/.local/bin
  unlink                               Remove pow from ~/.local/bin
  edit                                 Open dotfiles in \$EDITOR
  git     list|current|chacon|work     Switch git identity profile

${BOLD}FIRST RUN${RESET}
  cd ~/.dotfiles && ./pow init && ./pow link
EOF
    ;;
  *)
    __err "Unknown command: $cmd"
    echo "Run 'pow help'"
    exit 1
    ;;
esac
