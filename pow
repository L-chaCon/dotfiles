#!/bin/bash
# Thin wrapper so `./pow` works from the repo before dotfiles are stowed.
# The real implementation lives in the stowed CLI at ~/.local/scripts/pow
# (source: dotfiles/pow/.local/scripts/pow).
set -uo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$script_dir/dotfiles/pow/.local/scripts/pow" "$@"
